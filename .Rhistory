mutate(k_alpha = factor(as.character(k_level)),   # alphabetical: Good < Moderate < Poor
a_alpha = factor(as.character(a_level)))   # alphabetical: Negative < Positive < Uncertain
m_know_paper <- MASS::polr(
k_alpha ~ age + sex + edu + employment + family_type + income + child_sex + child_age + n_children,
data = dat, Hess = TRUE
)
# polr doesn't give p-values, so calculate them from the t-values
tidy_polr_p <- function(x, ...) {
broom::tidy(x, ...) |>
dplyr::mutate(p.value = 2 * pnorm(abs(statistic), lower.tail = FALSE))
}
table_4 <- tbl_regression(m_know_paper, exponentiate = TRUE, label = var_labels, tidy_fun = tidy_polr_p) |>
bold_p(t=0.05) |>
modify_caption("**Table 4 Factors associated with the level of knowledge among parents of school-going children (N=704). OR
odds ratio, CI confidence interval. *p-value ˂0.05 was considered statistically significant. Significant values are
in bold.**")
table_4 |> as_flex_table() |> save_as_docx(path = "table/Table4.docx")
table_4 |>
as_flex_table() |>
flextable::border_remove() |>
flextable::border_outer(border = officer::fp_border(color = "black", width = 1)) |>
flextable::border_inner(border = officer::fp_border(color = "black", width = 1)) |>
flextable::save_as_docx(path = "table/Table4.docx")
#| label: model-attitude
m_att <- MASS::polr(
a_level ~ age + sex + edu + employment + family_type + income +
child_sex + child_age + n_children,
data = dat, Hess = TRUE
)
# polr doesn't give p-values, so calculate them from the t-values
tidy_polr_p <- function(x, ...) {
broom::tidy(x, ...) |>
dplyr::mutate(p.value = 2 * pnorm(abs(statistic), lower.tail = FALSE))
}
table_5 <- tbl_regression(m_att, exponentiate = TRUE, label = var_labels,tidy_fun = tidy_polr_p) |>
bold_p(t=0.05) |>
modify_caption("**Table 5 : Factors associated with the level of attitudes towards antibiotic resistance among parents of school-
going children (N=704). OR odds ratio, CI confidence interval. *p-value˂0.05 was considered statistically
significant. Significant values are in bold.**")
table_5 |> as_flex_table() |> save_as_docx(path = "table/Table5.docx")
table_5 |>
as_flex_table() |>
flextable::border_remove() |>
flextable::border_outer(border = officer::fp_border(color = "black", width = 1)) |>
flextable::border_inner(border = officer::fp_border(color = "black", width = 1)) |>
flextable::save_as_docx(path = "table/Table5.docx")
#| label: model-practice
dat <- dat |>
mutate(
k_ref = fct_relevel(factor(k_level, ordered = FALSE), "Good"),
a_ref = fct_relevel(factor(a_level, ordered = FALSE), "Negative")
)
m_prac <- glm(
misuse ~ age + sex + edu + employment + family_type + income +
child_sex + child_age + n_children + k_ref + a_ref,
data = dat, family = binomial
)
table_6 <- tbl_regression(
m_prac, exponentiate = TRUE,
label = c(var_labels,
list(k_ref ~ "Knowledge level", a_ref ~ "Attitude level"))) |>
bold_p(t=0.05) |>
modify_caption("**Factors associated with the level of practices regarding antibiotic resistance among parents of school-
going children (N=704). OR odds ratio, CI confidence interval. *p value˂0.05 was considered statistically
significant. Significant values are in bold.**")
table_6 |>
as_flex_table() |>
flextable::border_remove() |>
