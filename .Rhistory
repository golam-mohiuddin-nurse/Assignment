#| label: save
# 1. Cleaned data with readable labels
write_csv(dat, "AMR_KAP_clean.csv")
# 2. Fully numeric coded version for SPSS/Stata/other software
demo_vars <- c("age", "sex", "edu", "employment", "family_type", "income",
"child_sex", "child_age", "n_children", "caregiver",
"grandparents", "grandparents3", "k_level", "a_level", "p_level")
dat_coded <- dat |>
select(-k_alpha, -a_alpha, -k_ref, -a_ref) |>
mutate(across(all_of(demo_vars), as.integer))
# 3. A "value labels" table: which number means what
value_labels <- map_dfr(demo_vars, \(v) {
tibble(variable = v,
code     = seq_along(levels(dat[[v]])),
label    = levels(dat[[v]]))
})
write_csv(dat_coded,   "AMR_KAP_coded.csv")
write_csv(value_labels, "AMR_KAP_value_labels.csv")
write_csv(codebook,     "AMR_KAP_item_codebook.csv")
knitr::kable(value_labels)
#  install-packages
install.packages(c(
"tidyverse",   # data cleaning + graphs (dplyr, ggplot2, stringr, ...)
"readxl",      # read Excel files
"gtsummary",   # publication-style tables
"gt",          # table display engine used by gtsummary
"MASS",        # ordinal logistic regression (polr)
"psych",       # Cronbach's alpha
"knitr"        # simple tables
))
# load-packages
library(tidyverse)
library(readxl)
library(gtsummary)
# import
raw <- read_excel("AMR_KAP_No_Code .xlsx")
View (raw)
dim(raw)
glimpse(raw)
#| label: rename
orig_names <- names(raw)     # keep the original long names
new_names <- c(
# --- Section I: demographics (columns 1-11) ---
"age", "sex", "edu", "employment", "family_type", "income",
"child_sex", "child_age", "n_children", "caregiver", "grandparents",
# --- Section II: KNOWLEDGE, 12 items (columns 12-23) ---
"k_kills_bacteria", "k_amoxicillin", "k_azithromycin", "k_paracetamol",
"k_kills_virus", "k_diarrhoea", "k_flu_cough", "k_resistant_hard",
"k_misuse_leads_AR", "k_allergy", "k_flora", "k_infections_harder",
# --- Section III: ATTITUDE, 10 items (columns 24-33) ---
"a_see_another_dr", "a_unsatisfied_no_abx", "a_abx_safe", "a_no_indication",
"a_fever", "a_cold", "a_stop_when_better", "a_reuse", "a_keep_leftover",
"a_dr_informs",
# --- Section IV: PRACTICE, 6 items (columns 34-39) ---
"p_give_abx", "p_check_expiry", "p_seek_advice", "p_cough",
"p_pharmacy", "p_complete_dose",
# --- Section V: sources of information (columns 40-49) ---
"source_text", "src_leaflet", "src_prescriber", "src_dispenser", "src_nurse",
"src_colleague", "src_university", "src_internet", "src_social", "src_other",
# --- Reasons for giving antibiotics without a doctor (columns 50-62) ---
"reason_text", "why_not_severe", "why_no_time", "why_no_money",
"why_no_hospital", "why_pharmacy_convenient", "why_no_trust",
"why_no_confidence", "why_old_prescription", "why_suggestions",
"why_knowledge", "why_no_giving", "why_other"
)
# Safety check: we must have exactly one new name per column
stopifnot(length(new_names) == ncol(raw))
names(raw) <- new_names
#| label: codebook
key_pattern <- "\\((Yes|No|Agree|Disagree)\\)\\s*$"   # "(Yes)" at the end
codebook <- tibble(
item     = new_names[12:39],              # the 28 KAP questions
original = str_squish(orig_names[12:39])  # str_squish removes odd spaces
) |>
mutate(
correct = str_match(original, key_pattern)[, 2],            # e.g. "Yes"
label   = str_squish(str_remove(original, key_pattern)),    # question text
domain  = str_sub(item, 1, 1)                               # k / a / p
)
stopifnot(!anyNA(codebook$correct))   # every item must have a correct answer
codebook |> select(item, label, correct, domain) |> knitr::kable()
#| label: clean-demographics
dat <- raw |>
# 1. Strip hidden/extra spaces from every text column
mutate(across(where(is.character), str_squish)) |>
# 2. Add an ID number for each parent
mutate(id = row_number(), .before = 1) |>
# 3. Recode the demographic variables
mutate(
n_children = as.character(n_children),
age = case_when(
str_detect(age, "^<")  ~ "<25",
str_detect(age, "^25") ~ "25–35",
str_detect(age, "^36") ~ "36–45",
str_detect(age, "^>")  ~ ">45"
),
age = factor(age, levels = c("<25", "25–35", "36–45", ">45")),
sex = factor(sex, levels = c("Female", "Male")),
edu = factor(edu, levels = c("Postgraduate", "Undergraduate",
"Secondary", "Primary")),
employment = factor(employment,
levels = c("Employed", "Self employed", "Not employed")),
family_type = factor(family_type,
levels = c("Extended family", "Nuclear family",
"Single parent family")),
# Income is in BDT in your file (the paper converted it to USD)
income = case_when(
str_detect(income, "^High")   ~ "High",
str_detect(income, "^Middle") ~ "Middle",
str_detect(income, "^Low")    ~ "Low"
),
income = factor(income, levels = c("High", "Middle", "Low")),
child_sex = factor(child_sex, levels = c("Female", "Male")),
child_age = case_when(
str_detect(child_age, "^<") ~ "<5",
str_detect(child_age, "^5") ~ "5–9",
str_detect(child_age, "^>") ~ ">10"
),
child_age = factor(child_age, levels = c("<5", "5–9", ">10")),
n_children = case_when(
str_detect(n_children, "3") ~ ">=3",
n_children == "1"           ~ "1",
n_children == "2"           ~ "2"
),
n_children = factor(n_children, levels = c(">=3", "1", "2")),
caregiver = factor(caregiver,
levels = c("Mother", "Father", "Grandmother", "Others")),
grandparents = factor(grandparents,
levels = c("Never", "Sometimes", "Often", "Always")),
# The paper only has 3 groups (Never / Often / Always), so "Sometimes"
# was merged into "Often". We keep both versions.
grandparents3 = fct_collapse(grandparents, Often = c("Sometimes", "Often"))
)
#| label: check-clean
dat |> count(age)
dat |> count(employment)
dat |> count(child_age)      # one NA = the one parent with missing child age
sum(is.na(dat))              # how many missing cells in total
#| label: score-items
for (i in seq_len(nrow(codebook))) {
item <- codebook$item[i]
dat[[paste0("s_", item)]] <- as.integer(dat[[item]] == codebook$correct[i])
}
# Total scores = row sums of the scored items
dat <- dat |>
mutate(
k_score = rowSums(across(starts_with("s_k_"))),
a_score = rowSums(across(starts_with("s_a_"))),
p_score = rowSums(across(starts_with("s_p_")))
)
summary(dat[, c("k_score", "a_score", "p_score")])
#| label: levels
dat <- dat |>
mutate(
k_level = cut(k_score, breaks = c(-Inf, 4, 7, Inf),
labels = c("Poor", "Moderate", "Good"),
ordered_result = TRUE),
a_level = cut(a_score, breaks = c(-Inf, 4, 7, Inf),
labels = c("Negative", "Uncertain", "Positive"),
ordered_result = TRUE),
p_level = factor(if_else(p_score >= 5, "Good", "Misuse"),
levels = c("Good", "Misuse")),
misuse  = as.integer(p_level == "Misuse")
)
#| label: check-table3
table(dat$k_level)
table(dat$a_level)
table(dat$p_level)
#| label: alpha
get_alpha <- function(prefix) {
items <- dat |> select(starts_with(prefix))
psych::alpha(items, check.keys = FALSE)$total$raw_alpha
}
tibble(
section = c("Knowledge", "Attitude", "Practice"),
alpha   = c(get_alpha("s_k_"), get_alpha("s_a_"), get_alpha("s_p_"))
) |>
mutate(alpha = round(alpha, 2)) |>
knitr::kable()
#| label: table1
dat |>
select(age, sex, edu, employment, family_type, income, child_sex,
child_age, n_children, caregiver, grandparents3) |>
tbl_summary(
label = list(
age           ~ "Parent's age (years)",
sex           ~ "Parent's sex",
edu           ~ "Parent's education level",
employment    ~ "Employment status",
family_type   ~ "Family type",
income        ~ "Average household income per month (BDT)",
child_sex     ~ "Child's sex",
child_age     ~ "Child's age (years)",
n_children    ~ "Number of children",
caregiver     ~ "Leading child caregiver at home",
grandparents3 ~ "Grandparents involved in treatment decisions"
)
) |>
modify_caption("**Table 1. Demographic characteristics of study participants (N=704).**")
library(flextable)
table_1 |> as_flex_table() |> save_as_docx(path = "table/Table1.docx")
#| label: table2
table_2 <- dat |>
select(starts_with("src_")) |>
tbl_summary(
label = list(
src_leaflet    ~ "Pharmaceutical company leaflet",
src_prescriber ~ "Prescribers",
src_dispenser  ~ "Dispensers",
src_nurse      ~ "Nurses",
src_colleague  ~ "Colleague",
src_university ~ "University courses",
src_internet   ~ "Internet",
src_social     ~ "Social media",
src_other      ~ "Others"
)
) |>
modify_caption("**Table 2. Major sources of information about antibiotic parents (N=704).**")
table_2 |> as_flex_table() |> save_as_docx(path = "table/Table2.docx")
#| label: table3
table_3 <- dat |>
select(k_level, a_level, p_level) |>
tbl_summary(
label = list(k_level ~ "Knowledge level",
a_level ~ "Attitude level",
p_level ~ "Practice level")
) |>
modify_caption("**Table 3. Level of knowledge, attitudes, and practices towards antibiotic resistance among parents with school-
going children (N=704).**")
table_3 |> as_flex_table() |> save_as_docx(path = "table/Table3.docx")
plot_kap <- function(domain_code, title) {
lvls <- codebook$label[codebook$domain == domain_code]   # question order
# 1. percentages per item (all three results always present)
dat <- resp_long |>
filter(domain == domain_code) |>
count(label, result) |>
complete(label, result = c("Incorrect", "Uncertain", "Correct"),
fill = list(n = 0)) |>
group_by(label) |>
mutate(pct = 100 * n / sum(n)) |>
ungroup() |>
select(label, result, pct) |>
pivot_wider(names_from = result, values_from = pct) |>
mutate(label = factor(label, levels = rev(lvls))) |>   # first question on top
arrange(label) |>
mutate(y = row_number())
# 2. rectangles: Incorrect left, Uncertain split around 0, Correct right
rects <- bind_rows(
dat |> transmute(y, result = "Incorrect",
xmin = -(Uncertain / 2 + Incorrect), xmax = -Uncertain / 2),
dat |> transmute(y, result = "Uncertain",
xmin = -Uncertain / 2, xmax = Uncertain / 2),
dat |> transmute(y, result = "Correct",
xmin = Uncertain / 2, xmax = Uncertain / 2 + Correct)
) |>
mutate(result = factor(result, levels = c("Incorrect", "Uncertain", "Correct")))
# 3. plot
ggplot() +
geom_rect(data = rects,
aes(xmin = xmin, xmax = xmax,
ymin = y - 0.38, ymax = y + 0.38, fill = result)) +
geom_vline(xintercept = 0, linewidth = 0.3) +
# centre label (Uncertain %), hidden when it is 0%
geom_label(data = dat |> filter(Uncertain >= 0.5),
aes(x = 0, y = y, label = paste0(round(Uncertain), "%")),
size = 2.8, fill = "white", alpha = 0.85,
label.size = 0, label.padding = unit(0.12, "lines")) +
# edge labels: Incorrect % left, Correct % right
geom_text(data = dat,
aes(x = -112, y = y, label = paste0(round(Incorrect), "%")),
size = 3) +
geom_text(data = dat,
aes(x = 112, y = y, label = paste0(round(Correct), "%")),
size = 3) +
scale_y_continuous(breaks = dat$y,
labels = str_wrap(as.character(dat$label), 55),
expand = expansion(add = 0.6)) +
scale_x_continuous(breaks = seq(-100, 100, 50), labels = abs) +
scale_fill_manual(values = c(Incorrect = "#DDB35A",
Uncertain = "#E6E6E6",
Correct   = "#1FA39A"),
name = "Response") +
coord_cartesian(xlim = c(-125, 125), clip = "off") +
labs(title = title, x = "Percentage (N = 704)", y = NULL) +
theme_minimal(base_size = 11) +
theme(
# axis lines and ticks
axis.line.x  = element_line(colour = "black", linewidth = 0.5),
axis.line.y  = element_line(colour = "black", linewidth = 0.5),
axis.ticks.x = element_line(colour = "black", linewidth = 0.5),
axis.ticks.y = element_line(colour = "black", linewidth = 0.5),
axis.ticks.length = unit(4, "pt"),
# guide lines
panel.grid.major.y = element_line(colour = "grey80", linewidth = 0.3,
linetype = "dotted"),
panel.grid.major.x = element_line(colour = "grey85", linewidth = 0.3,
linetype = "dotted"),
panel.grid.minor   = element_blank(),
axis.text.x     = element_text(colour = "black"),
axis.text.y     = element_text(colour = "black"),
legend.position = "top",
plot.margin     = margin(10, 20, 10, 10))
}
#| label: fig1
#| fig-height: 6
#| fig-width: 8
fig_1 <- plot_kap("k", "Figure 1. Knowledge about antibiotics")
ggsave("figure/Figure1.png",plot=fig_1,width=8,height = 6,dpi = 300)
#| label: fig2
#| fig-height: 6
#| fig-width: 8
fig_2 <- plot_kap("a", "Figure 2. Attitude towards antibiotic use")
ggsave("figure/Figure2.png",plot=fig_2,width=8,height = 6,dpi = 300)
#| label: fig3
#| fig-height: 4
#| fig-width: 8
fig_3 <- plot_kap("p", "Figure 3. Practices regarding antibiotic use")
ggsave("figure/Figure3.png",plot=fig_3,width=8,height = 6,dpi = 300)
